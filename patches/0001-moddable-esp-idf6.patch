+
+esp_err_t microlink_rotate_node_key(void) {
+    nvs_handle_t nvs;
+    esp_err_t err = nvs_open(NVS_NAMESPACE, NVS_READWRITE, &nvs);
+    if (err != ESP_OK) return err;
+
+    /* The retained old key is also the durable in-progress marker. Refuse a
+     * second rotation even after a reboot so NodeKeyExpired cannot loop and
+     * overwrite the key the control plane expects in OldNodeKey. */
+    uint8_t pending_old_public[32];
+    size_t pending_length = sizeof(pending_old_public);
+    err = nvs_get_blob(nvs, NVS_KEY_OLD_WG_PUB, pending_old_public, &pending_length);
+    if (err == ESP_OK && pending_length == sizeof(pending_old_public)) {
+        nvs_close(nvs);
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (err != ESP_ERR_NVS_NOT_FOUND) {
+        nvs_close(nvs);
+        return err;
+    }
+
+    uint8_t old_public[32];
+    size_t length = sizeof(old_public);
+    err = nvs_get_blob(nvs, NVS_KEY_WG_PUB, old_public, &length);
+    if (err != ESP_OK || length != sizeof(old_public)) {
+        nvs_close(nvs);
+        return err == ESP_OK ? ESP_ERR_INVALID_SIZE : err;
+    }
+
+    uint8_t private_key[32];
+    uint8_t public_key[32];
+    generate_keypair(private_key, public_key);
+    err = nvs_set_blob(nvs, NVS_KEY_OLD_WG_PUB, old_public, sizeof(old_public));
+    if (err == ESP_OK)
+        err = nvs_set_blob(nvs, NVS_KEY_WG_PRI, private_key, sizeof(private_key));
+    if (err == ESP_OK)
+        err = nvs_set_blob(nvs, NVS_KEY_WG_PUB, public_key, sizeof(public_key));
+    if (err == ESP_OK)
+        err = nvs_commit(nvs);
+    nvs_close(nvs);
+    memset(private_key, 0, sizeof(private_key));
+    if (err == ESP_OK)
+        ESP_LOGI(TAG, "Rotated node key and retained previous public key");
+    return err;
+}
+
+void ml_registration_complete(microlink_t *ml) {
+    if (!ml || !ml->has_old_wg_public_key) return;
+    nvs_handle_t nvs;
+    if (nvs_open(NVS_NAMESPACE, NVS_READWRITE, &nvs) == ESP_OK) {
+        nvs_erase_key(nvs, NVS_KEY_OLD_WG_PUB);
+        nvs_commit(nvs);
+        nvs_close(nvs);
+    }
+    memset(ml->old_wg_public_key, 0, sizeof(ml->old_wg_public_key));
+    ml->has_old_wg_public_key = false;
+}
 
