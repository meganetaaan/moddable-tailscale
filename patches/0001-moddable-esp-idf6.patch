diff --git a/components/microlink/src/ml_register_codec.c b/components/microlink/src/ml_register_codec.c
new file mode 100644
index 0000000000000000000000000000000000000000..145e1552e604630999657b3d38eb3fd189930454
--- /dev/null
+++ b/components/microlink/src/ml_register_codec.c
@@ -0,0 +1,40 @@
+/**
+ * @file ml_register_codec.c
+ * @brief Register flow policy kept independent of ESP-IDF and cJSON
+ */
+
+#include "ml_register_codec.h"
+
+#include <stddef.h>
+
+static const char *nonempty(const char *value) {
+    return (value && value[0]) ? value : NULL;
+}
+
+void ml_register_request_fields_init(ml_register_request_fields_t *fields,
+                                     const uint8_t node_key[32],
+                                     const uint8_t old_node_key[32],
+                                     bool has_old_node_key,
+                                     const char *auth_key,
+                                     const char *followup) {
+    if (!fields) return;
+    fields->node_key = node_key;
+    fields->old_node_key = has_old_node_key ? old_node_key : NULL;
+    fields->auth_key = has_old_node_key ? NULL : nonempty(auth_key);
+    fields->followup = nonempty(followup);
+}
+
+ml_register_result_t ml_register_classify_response(
+    const ml_register_response_fields_t *fields) {
+    if (!fields) return ML_REGISTER_FATAL;
+    if (fields->timed_out) {
+        if (fields->approval_pending) return ML_REGISTER_NEEDS_APPROVAL;
+        return fields->followup_active ? ML_REGISTER_NEEDS_AUTH : ML_REGISTER_RETRY;
+    }
+    if (nonempty(fields->error)) return ML_REGISTER_FATAL;
+    if (fields->node_key_expired) return ML_REGISTER_NODE_KEY_EXPIRED;
+    if (nonempty(fields->auth_url)) return ML_REGISTER_NEEDS_AUTH;
+    if (fields->machine_authorized_present && !fields->machine_authorized)
+        return ML_REGISTER_NEEDS_APPROVAL;
+    return ML_REGISTER_OK;
+}
