+static esp_err_t copy_status_string(const char *source, char *buffer, size_t length) {
+    if (!buffer || length == 0) return ESP_ERR_INVALID_ARG;
+    if (!source || !source[0]) {
+        buffer[0] = '\0';
+        return ESP_ERR_NOT_FOUND;
+    }
+    strlcpy(buffer, source, length);
+    return ESP_OK;
+}
